output "talosconfig" {
  description = "talosctl client configuration (endpoints are the control plane IPs)."
  value       = data.talos_client_configuration.this.talos_config
  sensitive   = true
}
output "kubeconfig" {
  description = "Admin kubeconfig. Available once the cluster is healthy."
  value       = talos_cluster_kubeconfig.this.kubeconfig_raw
  sensitive   = true
  depends_on  = [data.talos_cluster_health.this]
}
output "kubernetes_client_configuration" {
  description = "Host, CA, client certificate and key for the helm and kubernetes providers in a separate addons stack."
  value       = talos_cluster_kubeconfig.this.kubernetes_client_configuration
  sensitive   = true
  depends_on  = [data.talos_cluster_health.this]
}
output "nodes" {
  description = "Per-node truth table: role, IP, profile, schematic ID and the installer image each node is supposed to run."
  value = {
    for k, n in var.nodes : k => {
      role            = n.role
      ip              = n.ip
      profile         = n.profile
      schematic_id    = try(talos_image_factory_schematic.this[n.profile].id, null)
      installer_image = try(local.installer_images[n.profile], null)
    }
  }
}
output "schematic_ids" {
  description = "Profile => Image Factory schematic ID."
  value       = { for k, s in talos_image_factory_schematic.this : k => s.id }
}
output "installer_images" {
  description = "Profile => installer image. Use with talosctl upgrade --image; Terraform does not upgrade running nodes."
  value       = local.installer_images
}
output "iso_urls" {
  description = "Profile => boot ISO URL for the first install (null for profiles with a custom installer_image)."
  value       = local.iso_urls
}
output "image_urls" {
  description = "All URLs Image Factory returned per profile (installer, iso, pxe, kernel, initramfs, uki, disk_image, ...)."
  value       = local.profile_urls
}
output "controlplane_ips" {
  description = "Control plane IPs, sorted by node name."
  value       = local.cp_ips
}
output "bootstrap_node" {
  description = "Node key etcd was bootstrapped on."
  value       = local.bootstrap_node
}
output "rendered_patches" {
  description = "Debug and test output: the config patches generated by the module (YAML strings) by scope. May contain user-supplied patch content."
  sensitive   = true
  value = {
    common       = local.common_patches
    controlplane = local.controlplane_patches
    worker       = local.worker_patches
    nodes        = local.node_patches
  }
}
output "config_contract" {
  description = "Version contract the machine config was generated with."
  value       = local.config_contract
}
